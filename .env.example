# =====================================================================================
#  Orrery configuration.  Copy this file to .env and fill in the values you need:
#      cp .env.example .env        (Windows PowerShell:  Copy-Item .env.example .env)
#  NEVER commit .env, paste it into an issue, or show it in a screenshot.
#  API keys stay on your machine: Orrery never sends them to the browser.
# =====================================================================================

# Which providers to load (comma-separated). A provider is only shown when it has
# a base URL and an API key (or <ID>_NO_KEY=true). Unused ones are simply skipped.
ORRERY_PROVIDERS=nvidia,gemini,openrouter,groq,openai,ollama

# Every provider uses the same five settings - <ID> is the upper-case provider id:
#   <ID>_LABEL          name shown in the model picker
#   <ID>_BASE_URL       any OpenAI-compatible endpoint (the part before /chat/completions)
#   <ID>_API_KEY        your key (leave empty to disable the provider)
#   <ID>_MODELS         comma-separated model IDs; leave empty to auto-detect from <base>/models
#   <ID>_VISION_MODELS  optional: model IDs that may receive images (also settable in config/models.json)
# Add your own provider by adding its id to ORRERY_PROVIDERS and the settings below.

# --- NVIDIA (free endpoints at build.nvidia.com - keys look like nvapi-...) ----------
NVIDIA_LABEL=NVIDIA
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODELS=deepseek-ai/deepseek-v4.1-flash,nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-super-vl-120b-a12b,moonshotai/kimi-k2.6,z-ai/glm-5.3-flash,mistralai/mistral-large-4-1t-a52b,stepfun-ai/step-5-preview,minimaxai/minimax-m3.1-flash,poolside/laguna-xs-2.1,google/gemma-4-31b-it,meta/muse-glimmer-30b,nvidia/nemotron-3.5-bolt-e4b,openai/gpt-oss-20b

# --- Google Gemini (key from Google AI Studio) ---------------------------------------
GEMINI_LABEL=Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- OpenRouter (many models; free ones end in :free - check openrouter.ai/models) ---
OPENROUTER_LABEL=OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/auto

# --- Groq (very fast inference - key from console.groq.com) ---------------------------
GROQ_LABEL=Groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- OpenAI (paid API - key from platform.openai.com) ---------------------------------
OPENAI_LABEL=OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini,gpt-4o

# --- Ollama on your own computer (no key; models are detected automatically) ---------
OLLAMA_LABEL=Ollama (local)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_NO_KEY=true
OLLAMA_MODELS=

# --- Network & security -----------------------------------------------------------------
# Port on this computer:  http://127.0.0.1:3000
ORRERY_PORT=3000
# 127.0.0.1 = only this computer can open Orrery (recommended).
# LAN mode: set ORRERY_BIND=0.0.0.0 to let phones/laptops on your network connect.
#   WARNING: LAN mode REQUIRES APP_PASSWORD - Orrery refuses to start without it.
#   Only use LAN mode on a network you trust (never on public Wi-Fi).
ORRERY_BIND=127.0.0.1
# Password for the login page (8+ characters). Required in LAN mode, optional otherwise.
# Instead of a plain password you can store a hash:  APP_PASSWORD_HASH=scrypt:...
#   (generate one with:  docker compose run --rm orrery python app.py hash-password)
APP_PASSWORD=
# Extra host names allowed in the browser address bar (e.g. orrery.home.lan), comma-separated.
ORRERY_ALLOWED_HOSTS=
# How long a login lasts, in hours (default 168 = 7 days).
ORRERY_SESSION_HOURS=168

# --- Optional system prompt applied to every chat ---------------------------------------
SYSTEM_PROMPT=
